{
    "$schema": "https://opencode.ai/config.json",
    "enabled_providers": [
        "openai",
    ],
    "provider": {
        "openai": {
            "whitelist": [
                "gpt-6-astra",
                "gpt-6-astra-fast",
                "gpt-6-luna",
                "gpt-6-luna-fast",
            ],
        },
    },
    "default_agent": "plan",
    "model": "openai/gpt-6-astra",
    "small_model": "openai/gpt-6-luna",
}
